<h1>app/views/work_progresses/edit.html.erb</h1>
<h1>作業進捗を編集する</h1>
<%= link_to "作業進捗一覧", book_specification_work_progresses_path(@book_specification) %>
<%= link_to "作業進捗情報", book_specification_work_progress_path(@book_specification) %>
<%= render "shared/error", model: @work_progress %>
<ul>
  <%= form_with model: [@book_specification, @work_progress], local: true do |f| %>
    <li>必須</li>
    <li>作業状態</li>
    <li>
      <%= f.radio_button :status, "1" %>完了
      <%= f.radio_button :status, "0" %>未完了
    </li>
    <li>必須</li>
    <li>
      <%= f.label :floor, "階数" %>
      <%= f.number_field :floor %>階
    </li>
    <li>
      <%= f.label :comment, "コメント" %>
      <%= f.text_field :comment %>
    </li>
    <li>必須</li>
    <li>
      <%= f.label :start_time, "開始時間" %>
      <%= f.datetime_local_field :start_time %>
    </li>
    <li>必須</li>
    <li>
      <%= f.label :end_time, "終了時間" %>
      <%= f.datetime_local_field :end_time %>
    </li>
    <li>必須</li>
    <li>
      <%= f.label :manager, "担当者" %>
      <%= f.text_field :manager, placeholder: "必須" %>
    </li>
    <div>
      <%= f.submit "作業進捗を編集する" %>
    </div>
  <% end %>
<ul>
