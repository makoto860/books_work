<p>Find me in app/views/work_progresses/index.html.erb</p>
<h1>作業進捗一覧</h1>
並び替え
<ul>
  <% @work_progresses.each do |work_progress| %>
    <% if work_progress.status == "1" %>
      <li>作業完了しました</li>
    <% else %>
      <li>作業未完了です</li>
    <% end %>
    <li>仕様書のID: <%= work_progress.book_specification.id %></li>
    <li>作成時間: <%= work_progress.created_at.to_formatted_s(:datetime_jp) %></li>
    <li>変更時間: <%= work_progress.updated_at.to_formatted_s(:datetime_jp) %></li>
    <li><%= link_to "作業進捗情報", book_specification_work_progress_path(work_progress.book_specification, work_progress) %></li>
    <li><%= link_to '作業進捗を編集する', edit_book_specification_work_progress_path(work_progress.book_specification, work_progress) %></li>
    ----------------------------------------------------------------------------------------------------------------------------------------------
  <% end %>
</ul>
