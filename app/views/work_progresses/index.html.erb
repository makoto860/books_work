<p>Find me in app/views/work_progresses/index.html.erb</p>
<h1>作業進捗一覧</h1>

<table>
  <thead>
    <tr>
      <th>作業状態</th>
      <th>階</th>
      <th>コメント</th>
      <th>開始時間</th>
      <th>終了時間</th>
      <th>担当者</th>
      <th>book_specificationのID</th>
      <th>作成時間</th>
      <th>変更時間</th>
    </tr>
  </thead>

  <tbody>
    <% @work_progresses.each do |work_progress| %>
      <tr>
        <td>
          <% if work_progress.status == "1" %>
            <p>完了</p>
          <% else work_progress.status == "0" %>
            <p>未完了</p>
          <% end %>
        </td>
        <td><%= work_progress.floor %></td>
        <td><%= work_progress.comment %></td>
        <td><%= work_progress.start_time %></td>
        <td><%= work_progress.end_time %></td>
        <td><%= work_progress.manager %></td>
        <td><%= work_progress.book_specification_id %></td>
        <td><%= work_progress.created_at %></td>
        <td><%= work_progress.updated_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>
