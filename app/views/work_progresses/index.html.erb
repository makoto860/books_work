<p>Find me in app/views/work_progresses/index.html.erb</p>
<h1>作業進捗一覧</h1>

<ul>
  <% @work_progresses.each do |work_progress| %>
    <% if work_progress.status == "1" %>
      <li>作業完了しました</li>
    <% else %>
      <li>作業未完了です</li>
    <% end %>
    </li>
    <li>階数:<%= work_progress.floor %></li>
    <li>コメント:<%= work_progress.comment %></li>
    <li>開始時間:<%= work_progress.start_time %></li>
    <li>終了時間:<%= work_progress.end_time %></li>
    <li>担当者:<%= work_progress.manager %></li>
    <li>仕様書のID:<%= work_progress.book_specification.id %></li>
    <li><th>本のタイトル:<%= work_progress.book_specification.title %></li>
    <li>部数:<%= work_progress.book_specification.number_of_copies %></li>
    <li>注意事項:<%= work_progress.book_specification.note %></li>
    <li>作成時間:<%= work_progress.created_at %></li>
    <li>変更時間:<%= work_progress.updated_at %></li>
    <li><%= link_to '作業進捗を編集する', edit_book_specification_work_progress_path(work_progress.book_specification, work_progress) %></li>
    ----------------------------------------------------------------------------------------------------------------------------------------------
  <% end %>
</ul>
