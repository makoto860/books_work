<h1>book_specifications/show.html.erb</h1>
<h3>仕様書情報</h3>
<ul>
  <li>本のID: <%= @book_specification.id %></li>
  <li>本のタイトル: <%= @book_specification.title %></li>
  <li>部数: <%= @book_specification.number_of_copies %>部</li>
  <li>台数: <%= @book_specification.number_of_machines %>台</li>
  <li>注意事項: <%= @book_specification.note %></li>
  <li>納期: <%= @book_specification.deadline.to_formatted_s(:date_jp) %></li>
  <li>作成者: <%= @book_specification.author %></li>
  <li>作成した時間: <%= @book_specification.created_at.to_formatted_s(:datetime_jp) %></li>
  <li>変更した時間: <%= @book_specification.updated_at.to_formatted_s(:datetime_jp) %></li>
</ul>

<h3>作業進捗登録フォーム</h3>
<%= form_with model: [@book_specification, @work_progress] do |f| %>
  <ul>
    <li>
      階数<%= f.number_field :floor, value: 1 %>
    </li>
    <li>
      <%= f.radio_button :status, "1" %>完了
      <%= f.radio_button :status, "0" %>未完了
    </li>
    <li>
      コメント<%= f.text_area :comment %>
    </li>
    <li>
      開始時間<%= f.datetime_local_field :start_time %>
    </li>
    <li>
      終了時間<%= f.datetime_local_field :end_time %>
    </li>
    <li>
      担当者<%= f.text_field :manager %>
    </li>
    <li>
      <%= f.submit "作業進捗を登録する" %>
    </li>
  </ul>
<% end %>
<%= link_to "作業進捗一覧", book_specification_work_progresses_path(@book_specification) %>
