<h1>book_specifications/show.html.erb</h1>
<h3>仕様書情報</h3>
<table>
  <tr>
    <th>本のID</th>
    <td><%= @book_specification.id %></td>
  </tr>
  <tr>
    <th>本のタイトル</th>
    <td><%= @book_specification.title %></td>
  </tr>
  <tr>
    <th>部数</th>
    <td><%= @book_specification.number_of_copies %></td>
  </tr>
  <tr>
    <th>台数</th>
    <td><%= @book_specification.number_of_machines %></td>
  </tr>
  <tr>
    <th>注意事項</th>
    <td><%= @book_specification.note %></td>
  </tr>
  <tr>
    <th>納期</th>
    <td><%= @book_specification.deadline %></td>
  </tr>
  <tr>
    <th>作成者</th>
    <td><%= @book_specification.author %></td>
  </tr>
</table>

<h3>作業進捗登録フォーム</h3>
<%= form_with model: [@book_specification, @work_progress] do |f| %>
  <ul>
    <li>
      階数<%= f.number_field :floor, value: 1 %>
    </li>
    <li>
      <%= f.radio_button :status, "1" %>完了
      <%= f.radio_button :status, "0" %>未完了
    </li>
    <li>
      コメント<%= f.text_area :comment %>
    </li>
    <li>
      開始時間<%= f.datetime_local_field :start_time %>
    </li>
    <li>
      終了時間<%= f.datetime_local_field :end_time %>
    </li>
    <li>
      担当者<%= f.text_field :manager %>
    </li>
    <li>
      <%= f.submit "作業進捗を登録する" %>
    </li>
  </ul>
<% end %>
<%= link_to "作業進捗一覧", book_specification_work_progresses_path(@book_specification) %>
