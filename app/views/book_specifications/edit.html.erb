<h1>book_specifications/edit</h1>
<div class="specifications-edit-container">
  <%= render "shared/error", model: @book_specification %>
  <h1>仕様書を編集</h1>
  <div class="specifications-edit-required">
    <h2 class="fas fa-star fa-spin"></h2>
    <h2>タイトル名、部数、納期、作成者は必須です</h2>
  </div>
  <ul class="specifications-edit-lists">
    <%= form_with model: @book_specification do |f| %>
      <li><%= f.label :title, "タイトル名" %></li>
      <li><%= f.text_field :title %></li>
      <li><%= f.label :number_of_copies, "部数" %></li>
      <li><%= f.number_field :number_of_copies %>部</li>
      <li><%= f.label :note, "注意事項" %></li>
      <li><%= f.text_area :note %></li>
      <li><%= f.label :deadline, "納期" %></li>
      <li><%= f.date_field :deadline %></li>
      <li><%= f.label :author, "作成者" %></li>
      <li><%= f.text_field :author %></li>
      <%= f.submit "仕様書の編集を完了する", class: "specifications-edit-btn" %>
    <% end %>
  </ul>
</div>
