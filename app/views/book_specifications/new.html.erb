<%= render "shared/error", model: @book_specification %>
<h1>仕様書新規作成</h1>
<%= form_with model: @book_specification do |f| %>
  <table>
    <tr>
      <th><%= f.label :title, "タイトル名" %></th>
      <td><%= f.text_field :title %>(必須)</td>
    </tr>

    <tr>
      <th><%= f.label :number_of_copies, "部数" %></th>
      <td><%= f.number_field :number_of_copies %>(必須)</td>
    </tr>

    <tr>
      <th><%= f.label :number_of_machines, "台数" %></th>
      <td><%= f.number_field :number_of_machines %>(必須)</td>
    </tr>

    <tr>
      <th><%= f.label :note, "注意事項" %></th>
      <td><%= f.text_area :note %></td>
    </tr>

    <tr>
      <th><%= f.label :deadline, "納期" %></th>
      <td><%= f.date_field :deadline %>(必須)と納期は今日以降</td>
    </tr>

    <tr>
      <th><%= f.label :author, "作成者" %></th>
      <td><%= f.text_field :author %>(必須)</td>
    </tr>
  </table>
  <div><%= f.submit "仕様書の登録を完了する"%></div>
<% end %>
