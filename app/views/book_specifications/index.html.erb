<h1>BookSpecifications#index</h1>
<ul>
  <% if @book_specification.present? %>
    <li><%= link_to "作業進捗一覧", book_specification_work_progresses_path(@book_specification) %></li>
    <li><%= link_to "仕様書を新規作成", :new_book_specification %></li>
  <% else %>
    <li><%= link_to "仕様書を新規作成", :new_book_specification %></li>
  <% end %>
</ul>
<%= form_with url: book_specifications_path, method: :get, local: true do |f| %>
  <%= f.select :sort, @book_specification_sort_list, { selected: params[:sort] }, onChange: "this.form.submit();" %>
<% end %>
<h3>仕様書一覧</h3>
<ul>
  <% @book_specifications.each do |book_specification| %>
    <li>本のタイトル: <%= book_specification.title %></li>
    <li>部数: <%= book_specification.number_of_copies %></li>
    <li>納期: <%= book_specification.deadline.to_formatted_s(:date_jp) %></li>
    <li>作成日: <%= book_specification.created_at.to_formatted_s(:datetime_jp) %></li>
    <li>更新日: <%= book_specification.updated_at.to_formatted_s(:datetime_jp) %></li>
    <li><%= link_to "仕様書情報", book_specification %></li>
    <li><%= link_to "仕様書編集", [:edit, book_specification] %></li>
    <li><%= link_to "仕様書削除", book_specification, data: { turbo_method: :delete, turbo_confirm: "仕様書を削除しますか？" } %></li>
    <br>
  <% end %>
</ul>
