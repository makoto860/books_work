<h1>BookSpecifications#index</h1>
<p>Find me in app/views/book_specifications/index.html.erb</p>
<h3>仕様書一覧</h3>
<h3>ユーザー情報一覧</h3>
<table>
  <thead>
    <tr>
      <th>id</th>
      <th>本のタイトル</th>
      <th>部数</th>
      <th>台数</th>
      <th>注意事項</th>
      <th>納期</th>
      <th>作成した人</th>
      <th>更新日</th>
      <th>作成日</th>
    </tr>
  </thead>
  <tbody>
    <% @book_specifications.each do |book_specification| %>
      <tr>
        <td><%= book_specification.id %></td>
      </tr>
      <% end %>
  </tbody>
</table>
<p><%= link_to "仕様書を新規作成", :new_book_specification %></p>
