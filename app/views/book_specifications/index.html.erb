<h1>BookSpecifications#index</h1>
<h3>仕様書一覧</h3>
<table>
  <thead>
    <tr>
      <th>id</th>
      <th>本のタイトル</th>
      <th>部数</th>
      <th>台数</th>
      <th>注意事項</th>
      <th>納期</th>
      <th>作成した人</th>
      <th>更新日</th>
      <th>作成日</th>
      <th>情報</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>
  <tbody>
    <% @book_specifications.each do |book_specification| %>
      <tr>
        <td><%= book_specification.id %></td>
        <td><%= book_specification.title %></td>
        <td><%= book_specification.number_of_copies %></td>
        <td><%= book_specification.number_of_machines %></td>
        <td><%= book_specification.note %></td>
        <td><%= book_specification.deadline.to_formatted_s(:date_jp) %></td>
        <td><%= book_specification.author %></td>
        <td><%= book_specification.created_at.to_formatted_s(:datetime_jp) %></td>
        <td><%= book_specification.updated_at.to_formatted_s(:datetime_jp) %></td>
        <td><%= link_to "仕様書情報", book_specification %></td>
        <td><%= link_to "仕様書編集", [:edit, book_specification] %></td>
        <td><%= link_to "仕様書削除", book_specification, data: { turbo_method: :delete, turbo_confirm: "仕様書を削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<p><%= link_to "仕様書を新規作成", :new_book_specification %></p>
